# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI API key
OPENAI_API_KEY=

# Optional: override the OpenAI API base URL, e.g. when routing requests
# through a proxy. Leave empty to use the default OpenAI endpoint.
OPENAI_BASE_URL=

# Optional: OpenAI chat model. Leave empty to use the bot's default
# (gpt-4.1-mini, see internal/llm/client.go for why).
OPENAI_MODEL=

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sa_hr_bot?sslmode=disable

# Number of question cycles (phase 3) per interview session. Substituted
# into the {{SESSION_CYCLE_LIMIT}} placeholder in prompts/system_prompt.md.
SESSION_CYCLE_LIMIT=8

# Comma-separated Telegram user IDs allowed to run /admin, /code, /codes,
# /delete_code, /tokens and /report. Leave empty to disable admin access.
ADMIN_IDS=

# Optional Telegram file_id for the KDIR lesson video. Leave empty locally to
# upload media/vid1-kdir.mp4 from disk. In production, a file_id avoids uploading
# the 13 MB file again when the lesson is resent.
KDIR_VIDEO_FILE_ID=
